load("@rules_cc//cc:defs.bzl", "cc_binary")

# std_module injects @local_config_cc//:std, which provides std.compat too.
# No explicit standard-module dependency is needed here.
cc_binary(
    name = "demo",
    srcs = ["main.cc"],
    features = [
        "cpp_modules",
        "std_module",
    ],
)
